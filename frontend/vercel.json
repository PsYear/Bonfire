{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(?:capture(?:\\.html)?|capture-api|dist-capture)(?:/.*)?",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404
    }
  ]
}
